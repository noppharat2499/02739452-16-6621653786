# Copy to .env and fill in. Never commit .env
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me

# TMDB v3 API key: https://www.themoviedb.org/settings/api (free)
TMDB_API_KEY=your_tmdb_v3_api_key_here

# Airflow web login (http://localhost:8080)
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change_me

# On Linux run: echo "AIRFLOW_UID=$(id -u)" and put it here. Leave 50000 on Windows/macOS.
AIRFLOW_UID=50000

# Optional tuning
MIN_ROWS=100
TVMAZE_SCRAPE_LIMIT=40
